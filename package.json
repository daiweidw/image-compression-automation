{
  "name": "image-compression-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,green \"pnpm --filter @ica/server dev\" \"pnpm --filter @ica/web dev\"",
    "build": "pnpm --filter @ica/web build && pnpm --filter @ica/server build",
    "start": "pnpm --filter @ica/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @ica/server test",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.54.2",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.39.1"
  }
}
